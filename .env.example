# =============================================================================
# VISE OS - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=VISE OS
DEBUG=true
ENVIRONMENT=development
# Valid environments: development, staging, production

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Directus)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/vise_os
# Format: postgresql://username:password@host:port/database

# -----------------------------------------------------------------------------
# Directus CMS
# -----------------------------------------------------------------------------
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=your_directus_admin_token
# Generate a static token in Directus Admin > Settings > Access Tokens

# -----------------------------------------------------------------------------
# Redis Configuration
# Uses separate DBs: 0=cache, 1=broker, 2=results
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
# Anthropic Claude (Primary AI provider)
ANTHROPIC_API_KEY=sk-ant-api...

# OpenAI GPT-4 (Optional fallback provider)
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Proxy Services
# Required for browser automation with residential IP rotation
# -----------------------------------------------------------------------------
# BrightData (Primary proxy provider)
BRIGHTDATA_USERNAME=your_brightdata_username
BRIGHTDATA_PASSWORD=your_brightdata_password

# Oxylabs (Optional secondary proxy provider)
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# -----------------------------------------------------------------------------
# CAPTCHA Services
# Required for solving reCAPTCHA, hCaptcha, Turnstile, etc.
# -----------------------------------------------------------------------------
# 2Captcha (Primary CAPTCHA solver)
TWOCAPTCHA_API_KEY=your_2captcha_api_key

# CapSolver (Optional backup CAPTCHA solver)
CAPSOLVER_API_KEY=

# -----------------------------------------------------------------------------
# SMS/Phone Verification Services
# Required for phone number verification during account registration
# -----------------------------------------------------------------------------
FIVESIM_API_KEY=your_5sim_api_key

# -----------------------------------------------------------------------------
# Payment Processing
# -----------------------------------------------------------------------------
# iyzico (Turkish payment gateway)
IYZICO_API_KEY=your_iyzico_api_key
IYZICO_SECRET_KEY=your_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Use https://api.iyzipay.com for production

# Stripe (Optional fallback payment gateway)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email Services
# -----------------------------------------------------------------------------
# Resend (Transactional email service)
RESEND_API_KEY=your_resend_api_key

# IMAP configuration for email verification extraction
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Fernet encryption key for PII field-level encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_32_byte_fernet_key_base64_encoded

# JWT secret for API authentication
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# Monitoring & Alerting
# -----------------------------------------------------------------------------
# Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALERT_CHAT_ID=your_telegram_chat_id
# Create a bot via @BotFather and add it to your alert group/channel

# Sentry error tracking (Optional)
SENTRY_DSN=

# Prometheus multi-process directory
# Required for multi-worker deployments to share metrics
# Use tmpfs in production: /dev/shm/prometheus_multiproc
prometheus_multiproc_dir=/tmp/prometheus_multiproc

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json
# Valid formats: json, console

# -----------------------------------------------------------------------------
# Worker Configuration
# -----------------------------------------------------------------------------
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=600
# Maximum time (seconds) for a single task before it's terminated

# -----------------------------------------------------------------------------
# Browser Automation
# -----------------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
# Timeout in milliseconds for page operations
BROWSER_SCREENSHOT_ON_ERROR=true
