# =============================================================================
# VISE OS API Server Dockerfile
# FastAPI application with browser automation support
# =============================================================================

# Build stage for dependencies
FROM python:3.12-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy dependency files
COPY pyproject.toml ./

# Install pip and build tools
RUN pip install --no-cache-dir --upgrade pip hatchling

# Create wheel from pyproject.toml
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /build/wheels .

# Install all dependencies to a clean location
RUN pip install --no-cache-dir --target=/build/deps .

# =============================================================================
# Production stage
# =============================================================================
FROM python:3.12-slim as production

# Labels
LABEL maintainer="VISE OS Team"
LABEL description="VISE OS API Server - FastAPI application for visa appointment automation"
LABEL version="0.1.0"

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    # Playwright configuration
    PLAYWRIGHT_BROWSERS_PATH=/app/.playwright \
    # Application settings
    APP_HOME=/app \
    APP_USER=vise

# Create non-root user for security
RUN groupadd --gid 1000 ${APP_USER} \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash ${APP_USER}

# Install runtime dependencies
# - curl: for health checks
# - wget: for downloading resources
# - ca-certificates: for HTTPS
# - libnss3, libnspr4, etc.: for Playwright/browser automation
# - fonts-liberation: for proper text rendering in browsers
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    fonts-liberation \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory
WORKDIR ${APP_HOME}

# Copy installed dependencies from builder
COPY --from=builder /build/deps /usr/local/lib/python3.12/site-packages/

# Copy application source code
COPY --chown=${APP_USER}:${APP_USER} src/ ${APP_HOME}/src/
COPY --chown=${APP_USER}:${APP_USER} pyproject.toml ${APP_HOME}/

# Create necessary directories
RUN mkdir -p ${APP_HOME}/logs \
    ${APP_HOME}/.playwright \
    /tmp/prometheus_multiproc \
    && chown -R ${APP_USER}:${APP_USER} ${APP_HOME} \
    && chown -R ${APP_USER}:${APP_USER} /tmp/prometheus_multiproc

# Install Playwright browsers as the app user
# Note: This adds ~500MB to the image but is required for browser automation
USER ${APP_USER}

# Install playwright browsers (chromium only to reduce size)
RUN python -m playwright install chromium \
    && python -m playwright install-deps chromium 2>/dev/null || true

# Fetch Camoufox browser for stealth automation
# This command may fail if camoufox is not fully installed, handle gracefully
RUN python -c "import camoufox; camoufox.fetch()" 2>/dev/null || echo "Camoufox fetch skipped - will run on first use"

# Expose the API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Default command - run the FastAPI application
CMD ["python", "-m", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
